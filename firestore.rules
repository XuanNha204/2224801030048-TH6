rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['favorites', 'playlists', 'updatedAt'])
        && request.resource.data.favorites is list
        && request.resource.data.playlists is list
        && request.resource.data.favorites.size() <= 1000
        && request.resource.data.playlists.size() <= 100;
    }
  }
}
